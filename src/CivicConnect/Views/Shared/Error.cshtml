@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="cc-auth">
    <div class="cc-card text-center">
        <h2>Something went wrong</h2>
        <p class="cc-sub">An error occurred while processing your request. Please try again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-navy" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</div>

