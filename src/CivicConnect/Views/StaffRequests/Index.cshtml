@model RequestSearchViewModel
@{
    ViewData["Title"] = "Work queue";
    var c = Model.Criteria;
}
<div class="cc-page-head">
    <div>
        <h2>Work queue</h2>
        <p class="cc-sub">Search, filter and pick up requests.</p>
    </div>
</div>

<form method="get" class="cc-card cc-filter">
    <div class="grow">
        <label class="form-label" for="Text">Search</label>
        <input id="Text" name="Text" value="@c.Text" class="form-control" placeholder="Reference or description" />
    </div>
    <div>
        <label class="form-label" for="CategoryId">Category</label>
        <select id="CategoryId" name="CategoryId" asp-items="Model.Categories" class="form-select"><option value="">All categories</option></select>
    </div>
    <div>
        <label class="form-label" for="Status">Status</label>
        <select id="Status" name="Status" asp-items="Html.GetEnumSelectList<RequestStatus>()" class="form-select"><option value="">Any status</option></select>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="IncludeClosed" name="IncludeClosed" value="true" checked="@c.IncludeClosed" />
        <label class="form-check-label" for="IncludeClosed">Include closed</label>
    </div>
    <button type="submit" class="btn btn-navy">Filter</button>
</form>

<div class="cc-card cc-table-wrap">
    @if (!Model.Results.Items.Any())
    {
        <div class="cc-empty">No requests match these filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table cc-table">
                <thead>
                    <tr>
                        <th><a asp-action="Index" asp-route-SortBy="ReferenceNo" asp-route-Descending="@(c.SortBy == "ReferenceNo" && !c.Descending)" asp-route-Text="@c.Text" asp-route-CategoryId="@c.CategoryId" asp-route-Status="@c.Status" asp-route-IncludeClosed="@c.IncludeClosed">Reference</a></th>
                        <th><a asp-action="Index" asp-route-SortBy="Category" asp-route-Descending="@(c.SortBy == "Category" && !c.Descending)" asp-route-Text="@c.Text" asp-route-CategoryId="@c.CategoryId" asp-route-Status="@c.Status" asp-route-IncludeClosed="@c.IncludeClosed">Category</a></th>
                        <th><a asp-action="Index" asp-route-SortBy="Status" asp-route-Descending="@(c.SortBy == "Status" && !c.Descending)" asp-route-Text="@c.Text" asp-route-CategoryId="@c.CategoryId" asp-route-Status="@c.Status" asp-route-IncludeClosed="@c.IncludeClosed">Status</a></th>
                        <th>Assigned to</th>
                        <th><a asp-action="Index" asp-route-SortBy="SubmittedAt" asp-route-Descending="@(c.SortBy == "SubmittedAt" && !c.Descending)" asp-route-Text="@c.Text" asp-route-CategoryId="@c.CategoryId" asp-route-Status="@c.Status" asp-route-IncludeClosed="@c.IncludeClosed">Submitted</a></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Results.Items)
                    {
                        <tr>
                            <td><a class="cc-ref" asp-action="Details" asp-route-id="@r.Id">@r.ReferenceNo</a></td>
                            <td>@r.CategoryName</td>
                            <td><partial name="_StatusBadge" model="r.Status" /></td>
                            <td>@(r.AssignedStaffName ?? "Unassigned")</td>
                            <td>@r.SubmittedAt.ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@r.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<partial name="_Pager" model="Model" />
